# Copy to .env.local. Any provider without a key runs in demo mode in development
# (simulated payment, fixed sample results). Production refuses to start a provider
# without its key unless FLICKS_MOCK=1.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Kill-switch for every paid feature (checkout, analysis, try-on)
PAID_FEATURES_ENABLED=true
# Force demo mode for all providers
FLICKS_MOCK=
# Signs short-lived URLs for private photos. Required in production (any long random string).
MEDIA_SIGNING_SECRET=

# Supabase. With URL and secret key set, all data goes to Supabase; without them,
# development falls back to an in-memory store (lost on restart). Production requires them.
# Apply supabase/migrations first.
NEXT_PUBLIC_SUPABASE_URL=
# Not used yet (the browser never talks to Supabase directly); kept for the admin login.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# AI providers (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FASHN_API_KEY=
FASHN_MODEL=tryon-v1.6

# Payment (Midtrans, QRIS)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
