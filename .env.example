# Copy to .env.local. Any provider without a key runs in demo mode in development
# (simulated payment, fixed sample results). Production refuses to start a provider
# without its key unless FLICKS_MOCK=1.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Kill-switch for every paid feature (checkout, analysis, try-on)
PAID_FEATURES_ENABLED=true
# Force demo mode for all providers
FLICKS_MOCK=
# Trial mode: step 1 gives a token without payment, and the try-on may run in demo
# mode if FASHN has no key. Each free token still calls the real analysis model
# (about Rp200). Leave empty (off) for launch.
FREE_CHECKOUT=
# Signs short-lived URLs for private photos. Required in production (any long random string).
MEDIA_SIGNING_SECRET=

# Supabase. With URL and secret key set, all data goes to Supabase; without them,
# development falls back to an in-memory store (lost on restart). Production requires them.
# Apply supabase/migrations first.
NEXT_PUBLIC_SUPABASE_URL=
# Not used yet (the browser never talks to Supabase directly); kept for the admin login.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# AI providers (server-only)
# Analysis model via OpenRouter (personal color + body shape). Needs a vision model with
# JSON-schema output. Fallbacks are tried in order if the primary model is unavailable.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_FALLBACK_MODELS=google/gemini-3.7-flash
# Converts OpenRouter's USD charge to IDR in the usage log
USD_TO_IDR=18000
FASHN_API_KEY=
FASHN_MODEL=tryon-v1.6

# Payment (Midtrans, QRIS via Snap). Only the server key is used; the webhook
# signature is checked with it too. Sandbox keys start with "SB-Mid-server-".
# Set the Payment Notification URL in the Midtrans dashboard to
# <your domain>/api/webhooks/midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
